{
  "name": "paseo-turn-changes",
  "version": "0.1.0",
  "description": "Review per-turn agent file changes in Paseo with inline diff cards, a file tree, guarded undo, and an in-panel source editor.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Laokashouji/paseo-turn-changes.git"
  },
  "homepage": "https://github.com/Laokashouji/paseo-turn-changes#readme",
  "keywords": ["paseo", "paseo-plugin", "code-review", "diff", "codex", "claude"],
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format:files": "oxfmt",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node tests/ui-smoke.mjs"
  },
  "dependencies": {
    "@getpaseo/highlight": "0.8.0",
    "diff": "8.0.2"
  },
  "devDependencies": {
    "@getpaseo/plugin": "^0.8.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
